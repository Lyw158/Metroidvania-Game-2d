config_version=5

[application]

config/name="MetroidvaniaGame2d"
run/main_scene="res://scenes/rooms/m1_playground.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://bu3mpg4bxsyhb"
SaveManager="*uid://dlvpedxvlaoev"

