theme_override_font_sizes/font_size = 36
text = "移动 A/D    跳跃 空格（短按矮跳，长按高跳）    下穿单向平台 按住 S + 空格
右侧土黄色薄板是单向平台：可从下方跳穿、站上去，再按 S + 空格 落下

M2 二段跳测试区（右侧单向平台塔）：
塔顶左侧的青色光球：碰到即解锁「二段跳」
右上高台只有二段跳才上得去；解锁后在空中再按一次 空格 追加跳跃
F1 键：切换二段跳解锁状态（调试对比用）"
metadata/_edit_group_ = true

